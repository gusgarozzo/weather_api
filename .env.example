# ------------------------------------------------------------------
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ------------------------------------------------------------------
PORT=

# ------------------------------------------------------------------
# CONFIGURACIÓN DE REDIS (Caché)
# ------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=

# Tiempo de vida (en segundos) de las entradas de caché para el clima.
CACHE_TTL_SECONDS=

# ------------------------------------------------------------------
# CONFIGURACIÓN DE LA API DEL CLIMA (ej. Visual Crossing)
# ------------------------------------------------------------------
# Clave de API para el servicio del clima.
VC_API_KEY=
# Grupo de unidades: 'metric' (Celsisus) o 'us' (Fahrenheit).
VC_UNIT_GROUP=
# Formato de respuesta deseado (debería ser 'json').
VC_CONTENT_TYPE=
# Idioma para las descripciones de las condiciones climáticas (ej. 'es' para español).
VS_LANG=
# Ciudad por defecto para las consultas si no se especifica una.
VC_DEFAULT_CITY=

# ------------------------------------------------------------------
# CONFIGURACIÓN DE LA API DE IA (Gemini)
# ------------------------------------------------------------------
# Clave de API para el modelo de IA (Gemini).
GEMINI_API_KEY=